# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info

# ── Database (PostgreSQL) ─────────────────────────────
DATABASE_URL=postgresql://omnistock:omnistock@localhost:5432/omnistock?schema=public

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_KEY_PREFIX=omni

# ── Auth ──────────────────────────────────────────────
# Use `openssl rand -hex 32` to generate
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_REFRESH_TTL_REMEMBER_SECONDS=2592000

# ── Security / CORS ───────────────────────────────────
# Comma-separated origins, or * for all
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# ── Business ──────────────────────────────────────────
DEFAULT_TAX_RATE=0.08

# ── Email (optional — dev fallback logs reset tokens) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OmniStock <no-reply@omnistock.dev>"
APP_URL=http://localhost:3000

# ── AI Copilot (optional — rules engine used when unset) ─
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
